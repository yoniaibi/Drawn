{
  "expo": {
    "name": "DRAWN",
    "slug": "drawn",
    "version": "1.0.0",
    "owner": "drawnapp",
    "scheme": "drawn",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0F0A1E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.drawn.ios"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D1B69"
      },
      "package": "app.drawn.android"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/Drawn/webapp"
    }
  }
}
