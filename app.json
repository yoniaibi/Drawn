{
  "expo": {
    "name": "DRAWN",
    "slug": "drawn",
    "version": "1.0.0",
    "owner": "drawnapp",
    "scheme": "drawn",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0F0A1E",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.drawn.ios",
      "associatedDomains": [
        "applinks:drawn.app",
        "applinks:yoniaibi.github.io"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D1B69"
      },
      "package": "app.drawn.android",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "drawn.app" },
            { "scheme": "https", "host": "yoniaibi.github.io", "pathPrefix": "/Drawn" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/Drawn/webapp"
    }
  }
}
