# Copy to .env and fill in values (never commit .env)

# ── AWS Cognito (frontend) ────────────────────────────────────────────────────
# Get these from the AWS Console after running: cd backend && npx serverless deploy
EXPO_PUBLIC_AWS_USER_POOL_ID=eu-west-2_XXXXXXXXX
EXPO_PUBLIC_AWS_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── REST API base URL (frontend) ──────────────────────────────────────────────
# Printed at end of `serverless deploy` — looks like:
# endpoints: ANY - https://XXXXXXXX.execute-api.eu-west-2.amazonaws.com
EXPO_PUBLIC_API_URL=https://XXXXXXXX.execute-api.eu-west-2.amazonaws.com

# ── Backend env vars (set in your shell before deploying) ─────────────────────
# These are used by serverless.yml during `sls deploy`
USER_POOL_ID=eu-west-2_XXXXXXXXX
USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
